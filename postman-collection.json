    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Payment Status - Fake Signature (should fail 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-signature", "value": "thisisafakesignature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"1\",\n  \"status\": \"completed\",\n  \"event_id\": \"evt_fake_001\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/webhooks/payment-status",
              "protocol": "http", "host": ["localhost"], "port": "3000",
              "path": ["api", "webhooks", "payment-status"]
            }
          }
        },
        {
          "name": "Payment Status - Valid Signature",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// computes the HMAC so you don't have to do it manually",
                  "const body = {",
                  "    payment_id: '1',",
                  "    status: 'completed',",
                  "    event_id: 'evt_valid_' + Date.now()",
                  "};",
                  "const secret = 'test-webhook-secret-key';",
                  "const bodyStr = JSON.stringify(body);",
                  "const sig = CryptoJS.HmacSHA256(bodyStr, secret).toString();",
                  "pm.environment.set('webhook_sig', sig);",
                  "pm.environment.set('webhook_body', bodyStr);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-signature", "value": "{{webhook_sig}}" }
            ],
            "body": { "mode": "raw", "raw": "{{webhook_body}}" },
            "url": {
              "raw": "http://localhost:3000/api/webhooks/payment-status",
              "protocol": "http", "host": ["localhost"], "port": "3000",
              "path": ["api", "webhooks", "payment-status"]
            }
          }
        },
        {
          "name": "Payment Status - Duplicate event_id (send twice to test idempotency)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// fixed event_id so sending this twice proves the second is skipped",
                  "const body = {",
                  "    payment_id: '1',",
                  "    status: 'completed',",
                  "    event_id: 'evt_duplicate_test_001'",
                  "};",
                  "const secret = 'test-webhook-secret-key';",
                  "const bodyStr = JSON.stringify(body);",
                  "const sig = CryptoJS.HmacSHA256(bodyStr, secret).toString();",
                  "pm.environment.set('webhook_sig', sig);",
                  "pm.environment.set('webhook_body', bodyStr);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-signature", "value": "{{webhook_sig}}" }
            ],
            "body": { "mode": "raw", "raw": "{{webhook_body}}" },
            "url": {
              "raw": "http://localhost:3000/api/webhooks/payment-status",
              "protocol": "http", "host": ["localhost"], "port": "3000",
              "path": ["api", "webhooks", "payment-status"]
            }
          }
        }
      ]
    },
